# Required for the PayPal Sandbox checkout (server-side REST API).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Required for the PayPal JavaScript SDK in the browser. Use the same Sandbox client ID as PAYPAL_CLIENT_ID.
# This is a public client ID, never a secret.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Required for payment tracking. Use a server-side Supabase secret key; never add a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required to protect the merchant Recovery Centre and its review-action API with HTTP Basic Auth.
RECOVERY_CENTRE_USERNAME=
RECOVERY_CENTRE_PASSWORD=

# Required for the Recovery Centre Payment Failure Analyst. Keep this key server-side.
GEMINI_API_KEY=
# Optional Gemini model for payment analysis. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Optional: OpenAI key for the AG Studio assistant. If blank, OPENAI_API_KEY may be supplied in the server environment.
AG_STUDIO_OPENAI_API_KEY=

# Optional alternative if AG_STUDIO_OPENAI_API_KEY is unset (also read from the server environment).
OPENAI_API_KEY=

# Optional: comma-separated OpenAI model IDs allowed for the assistant. First model is the default.
# If blank, the assistant uses gpt-5.4-mini.
OPENAI_MODELS=
